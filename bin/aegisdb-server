#!/usr/bin/env bash
# =====================================================================
# AegisDB Standalone Server Process Launcher
# Master Project Plan §2, §4, §5 & §24
# =====================================================================

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE=""
NODE_ID=""

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --config) CONFIG_FILE="$2"; shift ;;
        --node-id) NODE_ID="$2"; shift ;;
        *) echo "Unknown parameter passed: $1"; exit 1 ;;
    esac
    shift
done

if [ -z "$CONFIG_FILE" ] || [ -z "$NODE_ID" ]; then
    echo "Usage: $0 --config <path> --node-id <id>"
    exit 1
fi

echo "====================================================================="
echo "  Starting AegisDB Server [Node ID: $NODE_ID]"
echo "  Configuration: $CONFIG_FILE"
echo "====================================================================="

CP="$DIR/lib/*"

exec java -cp "$CP" \
    se.mouaz.aegisdb.node.StandaloneLauncher \
    --config "$CONFIG_FILE" \
    --node-id "$NODE_ID"
