#!/usr/bin/env bash
# =====================================================================
# AegisDB Standalone Server Process Launcher
# Master Project Plan §2, §4, §5 & §24
# =====================================================================

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CP="$DIR/lib/*"

exec java -cp "$CP" \
    se.mouaz.aegisdb.node.AegisDbServer "$@"
